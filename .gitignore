# History and Session Data
.Rhistory
.RData
.Rproj.user

# Quarto internal folders
/.quarto/
_freeze/

# Ignore large/local build artifacts in source folders
# (But keep the ones in /docs/ so the website works)
**/*.html
**/*.docx
**/*.pptx
**/*.pdf
**/*.quarto_ipynb

# Whitelist the /docs/ folder and its contents
!/docs/
!/docs/**

# Whitelist shared HTML snippets included into rendered pages via include-after-body etc.
!/_includes/
!/_includes/**

.positai
.DS_Store
**/.DS_Store

# Weekly quizzes — instructor-only, never committed/pushed so students can't
# find them by browsing the public GitHub repo. Local-only; back up yourself.
/quiz/
