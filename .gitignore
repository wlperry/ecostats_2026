# History and Session Data
.Rhistory
.RData
.Rproj.user

# Quarto internal folders
/.quarto/
_freeze/

# Ignore large/local build artifacts in source folders
# (But keep the ones in /docs/ so the website works)
**/*.html
**/*.docx
**/*.pptx
**/*.pdf
**/*.quarto_ipynb

# Whitelist the /docs/ folder and its contents
!/docs/
!/docs/**

# Whitelist shared HTML snippets included into rendered pages via include-after-body etc.
!/_includes/
!/_includes/**

.positai
.DS_Store
**/.DS_Store

# Weekly quizzes — instructor-only, never committed/pushed so students can't
# find them by browsing the public GitHub repo. Local-only; back up yourself.
/quiz/
~$*
.~lock.*

# Large reference archives — 577 MB biol607 zip exceeds GitHub's 100 MB hard
# limit and blocked every push. Kept on disk, never committed.
readings/**/*.zip

# Unused 50 MB dataset that had been duplicated into 36 content/ and docs/
# folders (~1.76 GB). Referenced by no .qmd or .R file. Force-add if ever needed.
**/trees.csv

# Textbook companion data dropped in whole (Gotelli, Whitlock, Quinn & Keough).
# Reference material only — cleaned, renamed copies of the datasets a unit
# actually uses are committed under that unit's own content/<topic>/data/.
/datasets_from_books/

# Quiz banks — instructor-only, same reason as /quiz/: never committed or
# pushed, so students cannot find them by browsing the public GitHub repo.
# Local-only; back these up yourself.
/quizzes/

# ---------------------------------------------------------------------------
# Build output that was bloating .git (added 2026-10-08 during repo cleanup).
# All of this is regenerated by `quarto render` and none of it is served by
# the website — the published copies live under /docs/, which stays tracked.
# ---------------------------------------------------------------------------

# knitr/Quarto chunk caches (*.rdb/*.rdx) — 167 MB across 8,631 files.
**/*_cache/

# Render intermediates in the SOURCE tree. /docs/content/**/*_files/ holds the
# copies the site actually serves; these are throwaway duplicates of them.
content/**/*_files/

# Quarto's staging build of the whole site. Never needed in git; /docs/ is the
# published output.
/_site/

# macOS .webloc browser shortcuts. Several are iCloud dataless placeholders
# that git cannot read ("short read while indexing"), which aborts `git add`.
# They stay on disk; they just aren't tracked.
*.webloc
